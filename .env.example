# Database
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos
DATABASE_URL="postgresql://user:password@localhost:5432/kickoff_dev"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Auth (Generar claves seguras con: yarn generate:secrets o bash scripts/generate-secrets.sh)
API_SECRET="your-secret-key-here"
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Mail (si necesitas notificaciones)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="noreply@kickoff.local"
